# Copy this file to backend/.env and adjust values for your machine.
# The API loads this file automatically via pydantic-settings.

# PostgreSQL (psycopg v3 driver). Include a password if your role requires one:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/DrugForecastingDb
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/DrugForecastingDb

APP_NAME=Drug Receipts API

# Replace this before any non-local deployment.
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set to false only for local experiments. Tests disable auth via conftest.
AUTH_ENABLED=true

# Optional: enable Apple Silicon MPS for Temporal Fusion Transformer training.
# TFT_ENABLE_MPS=true
